# SAP S/4HANA Cloud OData Service Configuration
SAP_BASE_HOST=my403214-api.s4hana.cloud.sap
SAP_BASE_PATH=/sap/opu/odata/sap/API_SALES_ORDER_SRV/
# Basic Auth header (Base64 of username:password)
SAP_AUTH_HEADER=Basic <INSERT_BASE64_CREDENTIALS>

# Short-Close Business Rules
# Note: Code '81' verified working in live testing. Update if SD config team specifies another code.
REJECTION_REASON_CODE=81
QUANTITY_THRESHOLD=5.0
TARGET_UNIT=ZMT

# Default Query Filters (rolling last 7 days by default when blank)
DEFAULT_DATE_FIELD=CreationDate
# Optional manual overrides (uncomment to fix to specific dates):
# DEFAULT_FROM_DATE=2024-01-01
# DEFAULT_TO_DATE=2024-03-31

# Safety Mode (true = inspect only, false = perform live writes)
DRY_RUN=true
